# Sao chép thành .env rồi sửa. KHÔNG đưa file .env lên Git.
# Dùng cho cả `docker compose` và khi chạy trực tiếp `uvicorn app.main:app` (app tự đọc .env ở thư mục gốc dự án).

# ---- PostgreSQL ----
POSTGRES_USER=review
POSTGRES_DB=review
# Đặt mật khẩu của riêng bạn (không dùng lại mật khẩu ở nơi khác)
POSTGRES_PASSWORD=
# Chỉ dùng khi chạy uvicorn trực tiếp (docker compose tự đặt POSTGRES_HOST=db).
# Bỏ trống POSTGRES_HOST và DATABASE_URL = chạy chế độ thư mục file (chỉ xem, không lưu thẩm định).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Hoặc dùng một chuỗi kết nối thay cho các dòng POSTGRES_* ở trên:
# DATABASE_URL=postgresql://review:matkhau@localhost:5432/review
# Số giây chờ PostgreSQL khi khởi động; quá thời gian thì app chạy chế độ chỉ xem (đọc thư mục data/)
DB_CONNECT_TIMEOUT=10

# ---- Đăng nhập ----
# Tên tài khoản quản trị (tạo tự động lần đầu chạy)
ADMIN_USERNAME=admin
# Để trống: lần đầu chạy tạo mật khẩu ngẫu nhiên, in ra log và lưu ở storage/initial_admin_password.txt.
# Có giá trị (>= 8 ký tự): admin dùng mật khẩu này (cũng là cách đặt lại khi quên mật khẩu admin).
ADMIN_PASSWORD=
# Khóa ký phiên đăng nhập. Để trống: tự sinh và lưu ở storage/.secret_key
SECRET_KEY=
# Số ngày phiên đăng nhập còn hiệu lực
SESSION_DAYS=14

# ---- Thư mục (đường dẫn tương đối tính từ thư mục gốc dự án) ----
# DATA_DIR=data
# STORAGE_DIR=storage
# Nhập tự động khi chạy uvicorn trực tiếp (để trống = không nhập):
# AUTO_IMPORT_DIR=data
# Nhập tự động khi chạy docker compose (mặc định /seed = ./data; đặt rỗng để tắt):
# DOCKER_AUTO_IMPORT_DIR=

# ---- Docker: cổng web ----
# APP_PORT=8080
# APP_BIND=127.0.0.1

# ---- OCR cho PDF scan mới (tùy chọn) ----
# GEMINI_API_KEY=
